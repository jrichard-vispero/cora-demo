{
  "name": "wrenmoor-orders",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:ui": "npm run build -w @wrenmoor/ui",
    "dev": "npm run build:ui && vite",
    "build": "npm run build:ui && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:ui && npm run typecheck -w @wrenmoor/ui && tsc -b",
    "lint": "oxlint",
    "test": "npm run build:ui && npm test -w @wrenmoor/ui && vitest run",
    "test:watch": "npm run build:ui && vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@wrenmoor/ui": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vispero/sage": "^0.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
